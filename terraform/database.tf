# database.tf
# Managed MySQL (RDS, Multi-AZ, encrypted, automated backups) in the isolated
# DB subnets. The password is generated by Terraform and stored in AWS Secrets
# Manager; it is never printed in outputs.

# -----------------------------------------------------------------------------
# Credentials
# -----------------------------------------------------------------------------
resource "random_password" "db" {
  length  = 32
  special = true
  # RDS forbids  /  @  "  and spaces. These specials are also safe in shell/YAML.
  override_special = "-_.~"
}

resource "aws_secretsmanager_secret" "db" {
  name                    = "${local.name_prefix}/db-credentials"
  description             = "MySQL credentials for the Drupal database"
  recovery_window_in_days = var.db_secret_recovery_window_in_days

  tags = {
    Name = "${local.name_prefix}-db-credentials"
  }
}

# Stored after the database exists so the secret can also hold host and port.
resource "aws_secretsmanager_secret_version" "db" {
  secret_id = aws_secretsmanager_secret.db.id

  secret_string = jsonencode({
    engine   = "mysql"
    host     = aws_db_instance.drupal.address
    port     = aws_db_instance.drupal.port
    dbname   = var.db_name
    username = var.db_username
    password = random_password.db.result
  })
}

# -----------------------------------------------------------------------------
# Subnet group (the isolated DB subnets in both AZs)
# -----------------------------------------------------------------------------
resource "aws_db_subnet_group" "main" {
  name        = "${local.name_prefix}-db-subnet-group"
  description = "Private database subnets for ${local.name_prefix}"
  subnet_ids  = aws_subnet.private_db[*].id

  tags = {
    Name = "${local.name_prefix}-db-subnet-group"
  }
}

# -----------------------------------------------------------------------------
# RDS MySQL instance
# -----------------------------------------------------------------------------
resource "aws_db_instance" "drupal" {
  identifier = "${local.name_prefix}-mysql"

  engine         = "mysql"
  engine_version = var.db_engine_version
  instance_class = var.db_instance_class

  allocated_storage     = var.db_allocated_storage
  max_allocated_storage = var.db_max_allocated_storage > 0 ? var.db_max_allocated_storage : null
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = var.db_name
  username = var.db_username
  password = random_password.db.result
  port     = var.db_port

  multi_az               = var.db_multi_az
  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.db.id]
  publicly_accessible    = false

  backup_retention_period = var.db_backup_retention_period
  backup_window           = var.db_backup_window
  maintenance_window      = var.db_maintenance_window
  copy_tags_to_snapshot   = true

  auto_minor_version_upgrade = true
  deletion_protection        = var.db_deletion_protection
  skip_final_snapshot        = var.db_skip_final_snapshot
  final_snapshot_identifier  = var.db_skip_final_snapshot ? null : "${local.name_prefix}-mysql-final"

  tags = {
    Name = "${local.name_prefix}-mysql"
  }
}